{
  "name": "@haneoka/vega-plugin-richtext",
  "version": "0.1.0",
  "description": "Format-neutral, lifecycle-safe rich-text service for Vega",
  "keywords": [
    "visual-novel",
    "rich-text",
    "plugin",
    "vega"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-plugin-richtext.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-plugin-richtext#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-plugin-richtext/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/vega": "workspace:*",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "vega": {
    "pluginApi": 1,
    "kind": "rich-text",
    "capabilities": [
      "rich-text"
    ],
    "permissions": [
      "ui:dom"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
